{
  "name": "@lhk714/ziwei-mcp",
  "version": "0.1.0",
  "description": "Deterministic Zi Wei Dou Shu (紫微斗数) chart calculation MCP Server with True Solar Time, global IANA DST support, and explicit school/convention switches",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "ziwei-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test --timeout 30000",
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build && bun test"
  },
  "keywords": [
    "ziwei",
    "ziweidoushu",
    "purple-star-astrology",
    "mcp",
    "model-context-protocol",
    "iztro",
    "true-solar-time",
    "chinese-astrology",
    "claude",
    "cursor",
    "bun"
  ],
  "author": "Wesley Liu",
  "license": "MIT",
  "homepage": "https://github.com/listen-hai/ziwei-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/listen-hai/ziwei-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/listen-hai/ziwei-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openfate/bazi-engine": "1.1.2",
    "@openfate/true-solar-time": "4.0.2",
    "city-timezones": "1.3.4",
    "geo-tz": "8.1.8",
    "iztro": "2.6.0",
    "lunar-lite": "0.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
